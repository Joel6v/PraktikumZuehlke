<Window x:Class="CharacterConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CharacterConfigurator"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Skirym Character Configuration" Height="800" Width="1240" Style="{StaticResource SkirymFont}" FontSize="18px">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="72.5"/>
            <RowDefinition Height="600"/>
            <RowDefinition Height="72.5"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="325"/>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="325"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="162.5"/>
                    <ColumnDefinition Width="162.5"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <DockPanel>
                <!-- Left Column -->
                <StackPanel DockPanel.Dock="Left" Width="325">
                    <Grid Height="600">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="350"/>
                            <RowDefinition Height="250"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel DockPanel.Dock="Right" Width="325">
                    <Grid Height="600">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="350"/>
                            <RowDefinition Height="250"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </StackPanel>

                <!-- Middle Column -->
                <StackPanel>
                    <!--Placeholder-->
                </StackPanel>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="325"/>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="325"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="225"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="1" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </Grid>

       

    </Grid>
</Window>

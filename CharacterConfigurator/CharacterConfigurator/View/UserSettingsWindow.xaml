<Window x:Class="CharacterConfigurator.View.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CharacterConfigurator.View"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Title="User Settings" Height="675" Width="590" Style="{StaticResource SkirymFont}" FontSize="18"
        Closing="Window_Closing">
    <!--Height=625 Width=755-->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="72.5"/>
            <RowDefinition Height="450"/>
            <RowDefinition Height="72.5"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GridBorderOutLine}"/>
        <Border Grid.Row="1" Style="{StaticResource GridBorderOutLine}" Margin="0,12.5,0,12.5"/>
        <Border Grid.Row="2" Style="{StaticResource GridBorderOutLine}"/>

        <!--Top Middle Grid-->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="325"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            
            <Border Style="{StaticResource GridBorderOutLine}" Margin="12.5,12.5,125,12.5">
                <TextBlock Text="Settings" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40"/>
            </Border>


            <!--Top Right Grid-->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12.5"/>
                    <ColumnDefinition Width="237.5"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="1" Content="username" VerticalAlignment="Center" Margin="12.5"
                       FontSize="28" Name="lblUsername"/>
                
            </Grid>
        </Grid>
        
        <!--Middle Grid-->
        <Grid Grid.Row="1" Margin="12.5,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="133"/>
                <ColumnDefinition Width="392"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="66.5"/>
                <RowDefinition Height="66.5"/>
                <RowDefinition Height="42.5"/>
                <RowDefinition Height="42.5"/>
                <RowDefinition Height="42.5"/>
                <RowDefinition Height="42.5"/>
                <RowDefinition Height="59.5"/>
                <RowDefinition Height="37.5"/>
            </Grid.RowDefinitions>

            <!--Left Column-->
            <Border Style="{StaticResource GridBorderOutLine}" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="7.5">
                <Image Name="imgProfilePicture"/>
            </Border>
            <Button Grid.Column="1" Grid.Row="0" Content="Change Profile Picture" Name="btnChangeProfilePicture"
                    Click="btnChangeProfilePicture_Click" Style="{StaticResource SettingsButton}"/>
            <Button Grid.Column="1" Grid.Row="1" Content="Delete Profile Picture" Name="btnDeleteProfilePicture"
                    Click="btnDeleteProfilePicture_Click" Style="{StaticResource SettingsButton}"/>
            
            
            <TextBlock Grid.Column="0" Grid.Row="2" Text="Username" VerticalAlignment="Center" Margin="22.5,0"/>
            <TextBox Grid.Column="1" Grid.Row="2" Name="txtChangeUsername" IsEnabled="False" Margin="17.5,5.5"/>
            <Button Grid.Column="1" Grid.Row="3" Content="Change Username" Name="btnChangeUsername"
                    Click="btnChangeUsername_Click" Margin="17.5,0,17.5,11"/>
            
            
            <TextBlock Grid.Column="0" Grid.Row="4" Text="Password" VerticalAlignment="Center" Margin="22.5,0"/>
            <TextBox Grid.Column="1" Grid.Row="4" Name="txtChangePassword" IsEnabled="False" Margin="17.5,5.5"/>
            <Button Grid.Column="1" Grid.Row="5" Content="Change Password" Name="btnChangePassword"
                    Click="btnChangePassword_Click" Margin="17.5,0,17.5,11"/>
            
            
            <GroupBox Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" Header="Appearance" Name="grpAppearance" Margin="12.5,0,12.5,-2.5">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Light Mode" Name="radLightMode" IsChecked="True" Checked="radLightMode_Checked"
                                 VerticalAlignment="Center" Margin="12.5,0,62.5,0"/>
                    
                    <RadioButton Content="Dark Mode" Name="radDarkMode" IsChecked="False" Checked="radDarkMode_Checked"
                                 VerticalAlignment="Center" Margin="0,0,0,0"/>
                    
                    <RadioButton Content="Grey Mode" Name="radGreyMode" IsChecked="False" Checked="radGreyMode_Checked"
                                 VerticalAlignment="Center" Margin="62.5,0,0,0"/>
                </StackPanel>
            </GroupBox>


            <TextBlock Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="2" Text="Account Creation Date" VerticalAlignment="Center"
                       Margin="22.5,0,22.5,-5"/>
            <TextBlock Grid.Column="1" Grid.Row="8" Text="Date" VerticalAlignment="Center" 
                       Margin="237.5,5,22.5,0" Name="txtblAccountCreationDate"/>


        </Grid>

        <!--Bottom Grid-->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="162.5"/>
                <ColumnDefinition Width="162.5"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource StandardButton}" Content="Delete Account" Margin="12.5"
                    Name="btnDeleteAccount" Click="btnDeleteAccount_Click"/>

            <Button Grid.Column="2" Style="{StaticResource StandardButton}" Content="Cancel" Margin="0,12.5,18.75,12.5"
                    Name="btnSettingsCancel" Click="btnSettingsCancel_Click"/>

            <Button Grid.Column="3" Style="{StaticResource StandardButton}" Content="Save" Margin="-6.25,12.5,31.25,12.5"
                    Name="btnSettingsSave" Click="btnSettingsSave_Click"/>


        </Grid>

    </Grid>
</Window>

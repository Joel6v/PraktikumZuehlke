<Window x:Class="CharacterConfigurator.View.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CharacterConfigurator.View"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Title="User Settings" Height="625" Width="755" Style="{StaticResource SkirymFont}" FontSize="18">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="72.5"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="72.5"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GridBorderOutLine}"/>
        <Border Grid.Row="1" Style="{StaticResource GridBorderOutLine}" Margin="0,12.5,0,12.5"/>
        <Border Grid.Row="2" Style="{StaticResource GridBorderOutLine}"/>

        <!--Top Middle Grid-->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="325"/>
                <ColumnDefinition Width="375"/>
            </Grid.ColumnDefinitions>
            
            <Border Style="{StaticResource GridBorderOutLine}" Margin="12.5,12.5,125,12.5">
                <TextBlock Text="Settings" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40"/>
            </Border>


            <!--Top Right Grid-->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212.5"/>
                    <ColumnDefinition Width="162.5"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="1" Content="username" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="28" Name="lblUsername"/>
                
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="162.5"/>
                <ColumnDefinition Width="550"/>
            </Grid.ColumnDefinitions>

            <!--Bottom Left Grid-->
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="162.5"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource StandardButton}" Content="Delete Account" Margin="12.5,12.5,12.5,12.5"
                        Name="btnDeleteAccount" Click="btnDeleteAccount_Click"/>
            </Grid>

            <!--Bottom Middle Grid-->
            <Grid Grid.Row="2" Grid.Column="1" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="162.5"/>
                    <ColumnDefinition Width="162.5"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource StandardButton}" Margin="12.5" Content="Discard Changes"
                Name="btnDiscardChange" Click="btnDiscardChange_Click"/>
                <Button Grid.Column="2" Style="{StaticResource StandardButton}" Margin="12.5" Content="Save Changes"
                Name="btnSaveChange" Click="btnSaveChange_Click"/>
            </Grid>
        </Grid>

    </Grid>
</Window>

<Window x:Class="CharacterConfigurator.View.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CharacterConfigurator.View"
        xmlns:controls="clr-namespace:CharacterConfigurator.View.Controls"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Title="Skirym Register" Height="200" Width="400" Style="{StaticResource SkirymFont}" FontSize="18">

    <Grid Margin="20,0,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Label Content="Username" Grid.Column="0" Grid.Row="0" Margin="0,25,0,-5"/>
        
        <Label Content="Password" Grid.Column="0" Grid.Row="1" Margin="0,15,0,-5"/>

        <Label Content="Username is not between 3-30 character long" Grid.Column="1" Grid.Row="0" Name="lblUsernameInvalid" Visibility="Hidden"
               Foreground="Red"/>

        <Label Content="Username is already taken." Grid.Column="1" Grid.Row="0" Name="lblUsernameTaken" Visibility="Hidden"
               Foreground="Red"/>

        <Label Content="Username cannot have any special characters" Grid.Column="1" Grid.Row="0" Name="lblUsernameSpecialCharacters" Visibility="Hidden"
               Foreground="Red"/>

        <Label Content="Password is less than 3 characters long" Grid.Column="1" Grid.Row="0" Name="lblPasswordInvalid" Visibility="Hidden"
               Foreground="Red"/>

        <TextBox Name="txtRegisterUsername" Grid.Column="1" Grid.Row="0" Margin="0,25,30,-5" Padding="5,6,5,6" TabIndex="0"/>
        
        <controls:RandomizedTextBox x:Name="txtRegisterPassword" Grid.Column="1" Grid.Row="1" Margin="0,15,30,5"
                 VerticalContentAlignment="Center" TextChanged="txtRegisterPassword_TextChanged" Panel.ZIndex="1" TabIndex="1"
                 Background="Transparent" Foreground="Black" Style="{StaticResource EnchantingTableFont}" Padding="5,0,5,0"/>
        
        <Button Content="Register" Name="btnRegister" Click="btnRegister_Click" Grid.Column="1" Grid.Row="2" Margin="145,7.5,30,7.5"
                TabIndex="2"/>
        
        <!--<Label Content="Login" Grid.Column="1" Grid.Row="2" Margin="95,-2.5,115,15"/>-->

        <CheckBox Content="Toggle" Grid.Column="0" Grid.Row="2" Margin="5,14,0,0" Name="chkToggle" TabIndex="4"
                  IsChecked="{Binding ElementName=txtLoginPassword, Path=IsRandomizationEnabled, Mode=TwoWay}"/>

        <Label Name="lblRegisterLogin" Content="Login" Grid.Column="1" Grid.Row="2" Margin="80,7,115,0"
               PreviewMouseDown="lblRegisterLogin_PreviewMouseDown" TabIndex="3" IsTabStop="True"
               Style="{StaticResource HoverOverText}"/>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<ApplicationIcon>Resources\Image\Favicon\s_logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Font\**" />
    <EmbeddedResource Remove="Font\**" />
    <None Remove="Font\**" />
    <Page Remove="Font\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Image\Favicon\s_logo.ico" />
    <None Remove="Resources\Image\robin.png" />
    <None Remove="View\Font\Balgruf-JRye7.ttf" />
    <None Remove="View\Font\minecraft-enchantment.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Image\Clothing\Headgear\" />
    <Folder Include="Resources\Image\Clothing\Chest\" />
    <Folder Include="Resources\Image\Clothing\Gloves\" />
    <Folder Include="Resources\Image\Clothing\Legs\" />
    <Folder Include="Resources\Image\Race\Male\" />
    <Folder Include="Resources\Image\Race\Female\" />
    <Folder Include="Resources\Image\Weapon\" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Image\Consumable\food.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Content Include="Resources\Image\Favicon\skirym_logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Image\Favicon\s_logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="View\Font\Balgruf-JRye7.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="View\Font\minecraft-enchantment.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
